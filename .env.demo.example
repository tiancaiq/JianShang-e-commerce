# MSB Commerce demo deployment environment template.
#
# Copy to .env.demo for local demo use:
#   Copy-Item .env.demo.example .env.demo
#
# Do not commit .env.demo. Replace every demo-change-me value before sharing
# an online deployment.

# Public local ports
FRONTEND_PORT=4200
API_GATEWAY_PORT=9000
AUTH_SERVICE_PORT=8085
PRODUCT_SERVICE_PORT=8091
KEYCLOAK_PORT=8181
MYSQL_PORT=3306
MONGO_PORT=27017

# MySQL: identity and catalog schemas
MYSQL_ROOT_PASSWORD=demo-change-me-mysql
IDENTITY_DB_NAME=identity
IDENTITY_DB_USERNAME=root
IDENTITY_DB_PASSWORD=demo-change-me-mysql
CATALOG_DB_NAME=catalog
CATALOG_DB_USERNAME=root
CATALOG_DB_PASSWORD=demo-change-me-mysql

# MongoDB: legacy product catalog compatibility
MONGO_DB_USERNAME=root
MONGO_DB_PASSWORD=demo-change-me-mongo
MONGO_DB_NAME=product-service

# Keycloak persistence and admin account
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=demo-change-me-keycloak-db
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=demo-change-me-admin
KC_HOSTNAME=localhost:8181

# Local OAuth URLs.
# Browser URL is what Chrome can open.
# Backchannel URL is what api-gateway can call from inside Docker Desktop.
KEYCLOAK_BROWSER_ISSUER_URI=http://localhost:8181/realms/msb-local
KEYCLOAK_BACKCHANNEL_ISSUER_URI=http://host.docker.internal:8181/realms/msb-local

# Keycloak clients from infra/keycloak/realm-msb-local.json.
KEYCLOAK_MARKETPLACE_CLIENT_ID=msb-marketplace
KEYCLOAK_MARKETPLACE_CLIENT_SECRET=local-dev-only-change-me-marketplace
KEYCLOAK_SELLER_PORTAL_CLIENT_ID=msb-seller-portal
KEYCLOAK_SELLER_PORTAL_CLIENT_SECRET=local-dev-only-change-me-seller-portal
KEYCLOAK_ADMIN_PORTAL_CLIENT_ID=msb-admin-portal
KEYCLOAK_ADMIN_PORTAL_CLIENT_SECRET=local-dev-only-change-me-admin-portal

# Gateway browser settings
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:4200
GATEWAY_LOGOUT_REDIRECT_URI=http://localhost:4200/
GATEWAY_SESSION_COOKIE_SECURE=false
GATEWAY_SESSION_TIMEOUT=30m

# Demo-only local secrets
JWT_SECRET=demo-change-me-at-least-32-bytes-long
BUSINESS_VERIFICATION_WEBHOOK_SECRET=demo-change-me-business-webhook

# Listing media storage
LISTING_MEDIA_STORAGE=s3
S3_ENDPOINT_URL=https://storage.googleapis.com
S3_REGION=auto
S3_BUCKET=jianshang
S3_ACCESS_KEY_ID=demo-change-me-access-key
S3_SECRET_ACCESS_KEY=demo-change-me-secret-key
S3_PATH_STYLE_ACCESS=true
S3_PUBLIC_BASE_URL=https://storage.googleapis.com/jianshang
