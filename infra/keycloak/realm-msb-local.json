      "email": "trade.seller@msb.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Mira",
      "lastName": "Chen",
      "attributes": {
        "displayName": ["Mira Chen"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "TradeSeller!2026",
          "temporary": false
        }
      ],
      "realmRoles": ["BUYER", "INDIVIDUAL_SELLER"]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "trade.buyer@msb.local",
      "email": "trade.buyer@msb.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Jon",
      "lastName": "Bell",
      "attributes": {
        "displayName": ["Jon Bell"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "TradeBuyer!2026",
          "temporary": false
        }
      ],
      "realmRoles": ["BUYER"]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "harbor.seller@msb.local",
      "email": "harbor.seller@msb.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Harbor",
      "lastName": "Seller",
      "attributes": {
        "displayName": ["Harbor Seller"]
      },
      "realmRoles": ["BUYER", "BUSINESS_USER"]
    },
    {
      "username": "service-account-msb-gateway-admin",
      "enabled": true,
      "serviceAccountClientId": "msb-gateway-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ]
}
