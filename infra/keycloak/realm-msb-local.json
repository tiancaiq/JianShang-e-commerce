{
  "realm": "msb-local",
  "enabled": true,
  "displayName": "MSB Local",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "rememberMe": false,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "BUYER",
        "description": "Default marketplace buyer role for authenticated users."
      },
      {
        "name": "INDIVIDUAL_SELLER",
        "description": "Coarse individual seller eligibility claim. Application services remain authoritative."
      },
      {
        "name": "BUSINESS_USER",
        "description": "Coarse business portal eligibility claim. Business membership is checked by application services."
      },
      {
        "name": "ADMIN_ELIGIBLE",
        "description": "Coarse admin portal eligibility claim. Granular admin permissions are checked by application services."
      }
    ]
  },
  "defaultRoles": [
    "offline_access",
    "uma_authorization",
    "BUYER"
  ],
  "clients": [
    {
      "clientId": "msb-marketplace",
      "name": "MSB Marketplace Local",
      "description": "Local marketplace client for the future gateway BFF flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-only-change-me-marketplace",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:9000/api/v1/auth/callback/marketplace"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ]
    },
    {
      "clientId": "msb-seller-portal",
      "name": "MSB Seller Portal Local",
      "description": "Local business seller portal client for the future gateway BFF flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-only-change-me-seller-portal",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:9000/api/v1/auth/callback/seller-portal"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ]
    },
    {
      "clientId": "msb-admin-portal",
      "name": "MSB Admin Portal Local",
      "description": "Local admin portal client for the future gateway BFF flow. Production admin auth must require MFA.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-only-change-me-admin-portal",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:9000/api/v1/auth/callback/admin-portal"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ]
    }
  ],
  "groups": [],
  "users": []
}
