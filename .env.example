# MSB E-Commerce local development environment template
#
# Copy this file to .env for local Docker Compose usage.
# Values here are examples only. Do not put real production secrets in this
# file, and do not commit .env or .env.* files.

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
PRODUCT_SERVICE_PORT=8080
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
AUTH_SERVICE_PORT=8085
API_GATEWAY_PORT=9000
FRONTEND_PORT=4200

# ---------------------------------------------------------------------------
# Gateway service routing
# ---------------------------------------------------------------------------
PRODUCT_SERVICE_URL=http://localhost:8080
ORDER_SERVICE_URL=http://localhost:8081
INVENTORY_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8084
AUTH_SERVICE_URL=http://localhost:8085

# ---------------------------------------------------------------------------
# Legacy product MongoDB path
# New MVP data should not add MongoDB dependencies without an ADR.
# ---------------------------------------------------------------------------
MONGO_PORT=27017
MONGO_DB_USERNAME=root
MONGO_DB_PASSWORD=local-dev-only-change-me
MONGO_DB_NAME=product-service
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=local-dev-only-change-me
MONGO_INITDB_DATABASE=product-service

# ---------------------------------------------------------------------------
# MySQL local infrastructure
# ---------------------------------------------------------------------------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=local-dev-only-change-me
ORDER_DB_USERNAME=root
ORDER_DB_PASSWORD=local-dev-only-change-me

# ---------------------------------------------------------------------------
# Keycloak local infrastructure
# Target production persistence follows the P1-08 guide.
# ---------------------------------------------------------------------------
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=keycloak
KEYCLOAK_PORT=8181
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-only-change-me

# ---------------------------------------------------------------------------
# Gateway BFF OIDC settings
# Local client secrets match infra/keycloak/realm-msb-local.json only.
# Production values must come from a secret manager.
# ---------------------------------------------------------------------------
KEYCLOAK_ISSUER_URI=http://localhost:8181/realms/msb-local
KEYCLOAK_MARKETPLACE_CLIENT_ID=msb-marketplace
KEYCLOAK_MARKETPLACE_CLIENT_SECRET=local-dev-only-change-me-marketplace
KEYCLOAK_SELLER_PORTAL_CLIENT_ID=msb-seller-portal
KEYCLOAK_SELLER_PORTAL_CLIENT_SECRET=local-dev-only-change-me-seller-portal
KEYCLOAK_ADMIN_PORTAL_CLIENT_ID=msb-admin-portal
KEYCLOAK_ADMIN_PORTAL_CLIENT_SECRET=local-dev-only-change-me-admin-portal
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:4200
GATEWAY_LOGOUT_REDIRECT_URI=http://localhost:4200/
GATEWAY_SESSION_COOKIE_SECURE=false
GATEWAY_SESSION_TIMEOUT=30m

# ---------------------------------------------------------------------------
# Legacy auth-service database path
# Auth migration to Keycloak/MySQL is handled by a separate roadmap slice.
# ---------------------------------------------------------------------------
AUTH_DB_HOST=localhost
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=local-dev-only-change-me
AUTH_DB_NAME=auth_service

# ---------------------------------------------------------------------------
# IAM-03 application identity schema
# ---------------------------------------------------------------------------
IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=3306
IDENTITY_DB_NAME=identity
IDENTITY_DB_USERNAME=root
IDENTITY_DB_PASSWORD=local-dev-only-change-me

# ---------------------------------------------------------------------------
# Business verification local webhook signing
# Production values must come from a secret manager.
# ---------------------------------------------------------------------------
BUSINESS_VERIFICATION_WEBHOOK_SECRET=local-dev-only-change-me-business-webhook

# ---------------------------------------------------------------------------
# Temporary legacy JWT value
# Do not use this architecture for new MVP auth work.
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-local-dev-secret-at-least-32-bytes

# ---------------------------------------------------------------------------
# Kafka local infrastructure
# ---------------------------------------------------------------------------
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_PORT=9081
KAFKA_UI_PORT=9080

# ---------------------------------------------------------------------------
# Local mail
# ---------------------------------------------------------------------------
MAIL_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# AWS production secret lookup placeholders
# Local development should not require AWS access.
# ---------------------------------------------------------------------------
AWS_REGION=us-west-2
AWS_SECRETS_PREFIX=/msb-ecom/local
